rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isReviewAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow get, list: if resource.data.approved == true || isReviewAdmin();

      allow create: if request.resource.data.keys().hasAll([
          'name', 'message', 'rating', 'approved', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'message', 'rating', 'approved', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 1200
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time;

      allow update: if isReviewAdmin()
        && resource.data.approved == false
        && request.resource.data.approved == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']);

      allow delete: if false;
    }
  }
}
